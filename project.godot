; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CHEMIA"
run/main_scene="uid://bvtbdjlhtskvc"
run/disable_stdout=true
run/disable_stderr=true
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

DomainManager="*res://domain_manager.gd"
CurrencyManager="*res://currency_manager.gd"
CharacterManager="*res://character_manager.gd"
PlayerData="*res://player_data.gd"
ReactionDB="*res://reaction_database.gd"
SceneTransition="*res://scene_transition.gd"
AssetLoader="*res://asset_loader.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"
window/handheld/orientation="sensor_landscape"

[editor_plugins]

enabled=PackedStringArray()

[file_customization]

folder_colors={
"res://bar_textures/": "red",
"res://image/": "orange"
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogues/chapter1.dialogue")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
